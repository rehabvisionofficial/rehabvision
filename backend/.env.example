# Copy this file to .env and fill in your own values. Never commit .env.
MONGO_URI=[YOUR_MONGODB_CONNECTION_STRING]
MONGO_DB_NAME=physio-coach
JWT_SECRET=[A_LONG_RANDOM_SECRET]
PORT=5001
CLIENT_ORIGIN=http://localhost:5173

# Email for "Forgot password". Leave blank to print reset links in the server console instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-character App password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RehabVision <you@gmail.com>"

# Hosting (Render): CLIENT_ORIGIN must be the Vercel site's address, e.g.
# CLIENT_ORIGIN=https://rehabvision.vercel.app (several allowed, comma-separated).
# Render is detected automatically to read visitors' real IPs for rate limiting;
# TRUST_PROXY=false|true|<number of proxies> overrides that.

# Review team (verification, financial aid, Whish/OMT payments): their account emails, comma-separated.
# These accounts see a "Review" tab. Nobody can make themselves a reviewer from the app.
ADMIN_EMAILS=

# Document uploads (physio ID, OPTL card, aid papers) go to a PRIVATE Cloudflare R2 bucket.
# Cloudflare dashboard -> R2 -> Create bucket (keep public access OFF), then
# R2 -> Manage API tokens -> Create token with "Object Read & Write" on that bucket only.
# Leave blank to keep uploads in MongoDB (fine for local development).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rehabvision-docs
# Optional: another S3-compatible endpoint (e.g. an EU-jurisdiction R2 bucket:
# https://<account id>.eu.r2.cloudflarestorage.com)
R2_ENDPOINT=
